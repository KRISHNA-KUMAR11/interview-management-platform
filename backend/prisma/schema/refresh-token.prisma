model RefreshToken {
  id         String    @id @default(uuid()) @map("_id")
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())
  user_agent String?
  ip_address String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
