NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Docker Compose MongoDB replica set (required for Prisma nested writes)
DATABASE_URL=mongodb://127.0.0.1:27017/interview_platform?replicaSet=rs0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=12

# Live calls. TURN_PUBLIC_IP is the address browsers can reach (127.0.0.1 on this machine).
STUN_URLS=stun:stun.l.google.com:19302,stun:127.0.0.1:3478
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_USERNAME=interview
TURN_PASSWORD=interview-turn

# Recordings. Local S3 from docker compose. Leave S3_ENDPOINT empty to keep files on disk.
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=us-east-1
S3_ACCESS_KEY=interview
S3_SECRET_KEY=interview-secret
S3_BUCKET=interview-recordings

# Candidate mail. Mailpit inbox is http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=interviews@localhost
